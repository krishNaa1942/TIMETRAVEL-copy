# ─────────────────────────────────────────────────────────────
# TimeTravel App — Environment Variables
# For LOCAL DEV: copy this file to .env and fill in your keys.
# For PRODUCTION: copy to .env.production on the VPS and fill in.
# ─────────────────────────────────────────────────────────────

# ── Domains (production deploy — scripts/deploy_vps.sh) ─────
# A records must point at the VPS IP.
DOMAIN=timetotravel.app
WEB_DOMAIN=${DOMAIN}
API_DOMAIN=api.${DOMAIN}
SSL_EMAIL=admin@${DOMAIN}

# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# CORS — comma-separated list of allowed browser origins (production)
# Example: ALLOWED_ORIGINS=https://timetotravel.app,https://www.timetotravel.app
ALLOWED_ORIGINS=

# ── PostgreSQL (docker-compose.prod.yml) ─────────────────────
POSTGRES_USER=timetravel
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=timetravel
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ── Redis (docker-compose.prod.yml) ──────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ── Grafana (docker-compose.prod.yml) ────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# ── Backups (scripts/backup_db.sh) ───────────────────────────
BACKUP_RETENTION_DAYS=14

# Supabase (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Google (Gemini AI)
GOOGLE_API_KEY=your-google-api-key

# Weather
OPENWEATHER_API_KEY=your-openweather-key

# Images
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
UNSPLASH_SECRET_KEY=your-unsplash-secret-key

# Maps & Places
TOMTOM_API_KEY=your-tomtom-key
FOURSQUARE_API_KEY=your-foursquare-key
FOURSQUARE_CLIENT_ID=your-foursquare-client-id
FOURSQUARE_CLIENT_SECRET=your-foursquare-client-secret

# News
NEWSAPI_KEY=your-newsapi-key

# Sentry (error tracking)
SENTRY_DSN=https://your-dsn@sentry.io/your-project
SENTRY_TRACES_SAMPLE_RATE=0.1
